---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies', ({ data }) => !data.draft);
  return studies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await study.render();
const { data } = study;

// Variant A: illustration beside title.
// Variant B (and C fallback): title full-width, heroQuote promoted into hero.
const isA = data.variant === 'A';

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });

// --- AEO structured data -------------------------------------------------
const pageUrl = new URL(`/case-studies/${study.slug}/`, Astro.site ?? 'https://10xstudio.dev').toString();
const heroAbs = data.heroImage
  ? new URL(data.heroImage, Astro.site ?? 'https://10xstudio.dev').toString()
  : undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": data.title,
  "description": data.description,
  "datePublished": data.pubDate.toISOString(),
  "author": { "@type": "Organization", "name": "10x Studio", "@id": "https://10xstudio.dev/#org" },
  "publisher": { "@id": "https://10xstudio.dev/#org" },
  "isPartOf": { "@id": "https://10xstudio.dev/#website" },
  "mainEntityOfPage": pageUrl,
  "about": data.industry,
  "keywords": (data.tags ?? []).join(", "),
  ...(heroAbs ? { "image": heroAbs } : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://10xstudio.dev/" },
    { "@type": "ListItem", "position": 2, "name": "Case studies", "item": "https://10xstudio.dev/case-studies/" },
    { "@type": "ListItem", "position": 3, "name": data.title, "item": pageUrl },
  ],
};
---
<Base
  title={`${data.title} — 10x Studio`}
  description={data.description}
  active="home"
  ogType="article"
  ogImage={data.heroImage}
  datePublished={data.pubDate.toISOString()}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <article class={`cs cs--variant-${data.variant}`}>

    {isA ? (
      <!-- VARIANT A — illustration beside the title on grid-bg -->
      <div class="grid-bg">
        <section class="mk-wrap cs-hero-a">
          <div class="cs-hero-a-text">
            <div class="article-meta">
              <span class="kind-badge">Case study</span>
              {data.duration && <span>{data.duration}</span>}
            </div>
            <h1 class="mk-h1">{data.title}</h1>
            <p class="article-lede">{data.description}</p>
          </div>
          {data.heroImage && (
            <figure class="cs-hero-a-fig" aria-hidden="true">
              <img src={data.heroImage} alt="" width="1254" height="1254" loading="eager" />
            </figure>
          )}
        </section>
      </div>
    ) : (
      <!-- VARIANT B — title full-width; heroQuote promoted above the title -->
      <div class="grid-bg">
        <section class="mk-wrap cs-hero-b">
          {data.heroQuote && (
            <p class="cs-hero-b-quote">"{data.heroQuote}"</p>
          )}
          <div class="article-meta">
            <span class="kind-badge">Case study</span>
            {data.duration && <span>{data.duration}</span>}
          </div>
          <h1 class="mk-h1">{data.title}</h1>
          <p class="article-lede">{data.description}</p>
        </section>
      </div>
    )}

    <!-- TITLE BLOCK — shared: client / industry / role / duration or shipped date -->
    <div class="mk-wrap">
      <div class="titleblock cs-titleblock">
        <div>
          Client
          <b>
            {data.clientUrl
              ? <a href={data.clientUrl} target="_blank" rel="noopener">{data.client}</a>
              : data.client}
          </b>
        </div>
        <div>Industry<b>{data.industry}</b></div>
        <div>Role<b>{data.role}</b></div>
        {data.duration
          ? <div>Duration<b>{data.duration}</b></div>
          : <div>Shipped<b>{fmt(data.pubDate)}</b></div>
        }
      </div>
    </div>

    <!-- METRICS BAND — shared, conditional; numbers on bone between hairline rules -->
    {data.metrics && data.metrics.length > 0 && (
      <section class="cs-metrics" aria-label="Project metrics">
        <div class="mk-wrap cs-metrics-inner">
          {data.metrics.map((m) => (
            <div class="cs-metric">
              <div class="cs-metric-n">{m.value}</div>
              <div class="cs-metric-l">{m.label}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- NARRATIVE + ASIDE — shared -->
    <section class="cs-narrative">
      <div class="mk-wrap article-body-wrap">
        <div class="article-body">
          <Content />
        </div>
        <aside class="article-aside">
          <!-- Illustration: shown in aside for Variant B (not in Variant A hero) -->
          {!isA && data.heroImage && (
            <div class="aside-block cs-aside-art">
              <img src={data.heroImage} alt={`${data.client} illustration`} width="1254" height="1254" loading="lazy" />
            </div>
          )}
          {data.stack && data.stack.length > 0 && (
            <div class="aside-block">
              <div class="aside-lbl">Stack</div>
              <div class="aside-tags">
                {data.stack.map((s) => <span class="tag">{s}</span>)}
              </div>
            </div>
          )}
          {data.tags && data.tags.length > 0 && (
            <div class="aside-block">
              <div class="aside-lbl">Tags</div>
              <div class="aside-tags">
                {data.tags.map((t) => <span class="tag">#{t}</span>)}
              </div>
            </div>
          )}
          <div class="aside-block">
            <div class="aside-lbl">Start a build like this</div>
            <p class="aside-text">If this is your shape of problem, the next step is a 30-minute working session.</p>
            <a href="/contact/" class="mk-btn mk-btn--primary">
              Start a Project Conversation <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </aside>
      </div>
    </section>

    <!-- PRINCIPLE QUOTE BAND — Variant A only (Variant B has quote in hero) -->
    {isA && data.heroQuote && (
      <section class="cs-quote-band">
        <div class="mk-wrap cs-quote-inner">
          <blockquote class="cs-quote">"{data.heroQuote}"</blockquote>
          {data.heroQuoteAttribution && (
            <div class="cs-quote-attr">{data.heroQuoteAttribution}</div>
          )}
        </div>
      </section>
    )}

    <!-- CTA BAND — shared graphite field from site.css -->
    <section class="cta-band">
      <div class="cta-band-inner">
        <h2>More like this? Tell us what you're <span class="accent">building.</span></h2>
        <div class="cs-cta-links">
          <a href="/contact/" class="mk-btn mk-btn--yellow mk-btn--lg">
            Start a Project Conversation <Icon name="arrow-right" size={18} />
          </a>
          <a href="/case-studies/" class="mk-btn mk-btn--lg mk-btn--on-dark">
            All case studies
          </a>
        </div>
      </div>
    </section>

  </article>
</Base>
