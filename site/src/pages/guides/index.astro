---
import Base from '../../layouts/Base.astro';
import WellTile from '../../components/WellTile.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// CollectionPage schema so the hub itself is machine-readable.
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "10x Studio Guides",
  "description": "Straight-answer guides on the cost, scope and choices behind custom software.",
  "url": "https://10xstudio.dev/guides/",
  "isPartOf": { "@id": "https://10xstudio.dev/#website" },
};
---
<Base
  title="Guides — Custom Software, Plainly Explained — 10x Studio"
  description="Straight-answer guides on what custom software costs, how it differs from templates, and what AI-native really means — for operators evaluating a build."
  active="guides"
  jsonLd={collectionSchema}
>

  <section class="svc-hero">
    <div class="svc-hero-inner">
      <div class="mk-eyebrow" style="margin-bottom:18px;"><b>//</b> Guides</div>
      <h1 class="mk-h1">Custom software, <span class="accent">plainly explained.</span></h1>
      <p>The questions every operator asks before a build — cost, timeline, custom-versus-template, where AI actually fits — answered straight, with real numbers and no sales fog.</p>
    </div>
  </section>

  <section class="mk-section">
    <div class="mk-wrap">
      <div class="blog-list">
        {guides.map((guide) => (
          <a href={`/guides/${guide.slug}/`} class="blog-card">
            <div class="blog-card-art">
              <WellTile set={guide.data.heroSet} size={96} />
            </div>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="kind">Guide</span>
                <span class="dot-sep">·</span>
                <span>Updated {fmt(guide.data.updatedDate ?? guide.data.pubDate)}</span>
              </div>
              <h2 class="mk-h3" style="font-size:28px; margin-top:10px;">{guide.data.title}</h2>
              <p class="blog-card-desc">{guide.data.description}</p>
              <div class="blog-card-tags">
                {guide.data.tags.map((t) => <span class="tag">#{t}</span>)}
              </div>
            </div>
            <span class="blog-card-arrow"><Icon name="arrow-up-right" size={22} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Base>
