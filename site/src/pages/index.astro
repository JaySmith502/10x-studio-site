---
import Base from '../layouts/Base.astro';
import WellTile from '../components/WellTile.astro';
---
<Base title="10x Studio — AI-native software for businesses with real complexity" active="home">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div>
        <div class="mk-eyebrow" style="margin-bottom:24px;">
          <span class="mk-badge mk-badge--blue">AI-native build partner</span>
          <span>Cybersecurity &amp; Fortune 500 background</span>
        </div>
        <h1 class="mk-h1">Software that does the work.<br>Not just <span class="accent">displays it.</span></h1>
        <p>We design and build web platforms, ecommerce systems, dashboards and custom software with AI and automation engineered in from day one — led by a senior partner who has shipped enterprise software for Fortune 500 and cybersecurity teams.</p>
        <div class="hero-ctas">
          <a href="/contact/" class="mk-btn mk-btn--primary mk-btn--lg">
            Start a Project Conversation <i data-lucide="arrow-right" style="width:18px;height:18px;"></i>
          </a>
          <a href="/services/" class="mk-btn mk-btn--outline mk-btn--lg">See What We Build</a>
        </div>
      </div>

      <div class="hero-art">
        <div class="cell" style="background:var(--blue-500); align-items:flex-end; justify-content:flex-start;">
          <span class="cell-label">Build</span>
        </div>
        <div class="cell" style="background:var(--yellow-500);">
          <span class="circle" style="background:var(--red-500);"></span>
        </div>
        <div class="cell" style="background:var(--ink-900);">
          <span class="circle" style="background:var(--yellow-500);"></span>
        </div>
        <div class="cell" style="background:var(--red-500); align-items:flex-end; justify-content:flex-end;">
          <span class="cell-label" style="text-align:right;">Automate</span>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAND -->
  <section class="stats-band">
    <div class="stats-band-inner">
      <div class="stats-eyebrow"><span>// Recent automation<br>builds</span></div>
      <div class="stat"><div class="n">70%</div><div class="l">reduction in email triage</div></div>
      <div class="stat alt"><div class="n">50%</div><div class="l">faster deal evaluation</div></div>
      <div class="stat"><div class="n">65%</div><div class="l">lift in task completion</div></div>
    </div>
  </section>

  <!-- SERVICES PREVIEW -->
  <section class="mk-section">
    <div class="mk-wrap">
      <div class="section-head">
        <div>
          <div class="mk-eyebrow" style="margin-bottom:14px;"><b>//</b> What we build</div>
          <h2 class="mk-h2">Platforms that move work,<br>not just pixels.</h2>
        </div>
        <a href="/services/" class="mk-btn mk-btn--outline">
          All services <i data-lucide="arrow-up-right" style="width:16px;height:16px;"></i>
        </a>
      </div>

      <div class="svc-grid svc-grid--3-2">
        <a href="/services/#web" class="svc-card">
          <WellTile set="web" />
          <h3 class="mk-h3">Custom Web Platforms</h3>
          <p>Marketing sites with real workflows behind them — portals, intake systems, dashboards, role-based access, the parts that actually run the business.</p>
          <span class="arrow">Read more <i data-lucide="arrow-right" style="width:12px;height:12px;"></i></span>
        </a>
        <a href="/services/#ecom" class="svc-card">
          <WellTile set="ecom" />
          <h3 class="mk-h3">Ecommerce &amp; Product Platforms</h3>
          <p>Catalogs, configurable products, checkout, customer accounts, fulfillment logic — selling online as an operating system, not just a cart.</p>
          <span class="arrow">Read more <i data-lucide="arrow-right" style="width:12px;height:12px;"></i></span>
        </a>
        <a href="/services/#ops" class="svc-card">
          <WellTile set="ops" />
          <h3 class="mk-h3">Internal Business Tools</h3>
          <p>When spreadsheets become load-bearing infrastructure. Admin dashboards, approval flows, job tracking, reporting — built for the people who use them daily.</p>
          <span class="arrow">Read more <i data-lucide="arrow-right" style="width:12px;height:12px;"></i></span>
        </a>
        <a href="/services/#ai" class="svc-card">
          <WellTile set="ai" />
          <h3 class="mk-h3">AI-Enabled Workflow Tools</h3>
          <p>Intake triage, document summarization, RAG over your knowledge, customer support copilots. AI where it actually reduces friction — never as decoration.</p>
          <span class="arrow">Read more <i data-lucide="arrow-right" style="width:12px;height:12px;"></i></span>
        </a>
        <a href="/services/#auto" class="svc-card">
          <WellTile set="auto" />
          <h3 class="mk-h3">Integrations &amp; Automation</h3>
          <p>CRM, payments, notifications, data sync. Your stack should feel like a team — not a group project where nobody read the instructions.</p>
          <span class="arrow">Read more <i data-lucide="arrow-right" style="width:12px;height:12px;"></i></span>
        </a>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="why-section">
    <div class="mk-wrap">
      <div class="mk-eyebrow" style="margin-bottom:14px;"><b>//</b> Why 10x Studio</div>
      <h2 class="mk-h2">Senior, not staffed.</h2>
      <div class="why-grid">
        <div class="why-1">
          <div class="n">01</div>
          <h3 class="mk-h3">AI-native from day one</h3>
          <p>We ask which steps shouldn't exist before we build them. Most shops bolt AI on at the end — we design around it from discovery.</p>
        </div>
        <div class="why-2">
          <div class="n">02</div>
          <h3 class="mk-h3">Enterprise pedigree</h3>
          <p>Led by an engineer with cybersecurity and Fortune 500 software experience. Your platform gets the same rigor as the systems that protect them.</p>
        </div>
        <div class="why-3">
          <div class="n">03</div>
          <h3 class="mk-h3">Built for adoption</h3>
          <p>Your team has to use this on Monday. We design for the operator on the floor, not the slide in the boardroom.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="cta-band">
    <div class="cta-band-inner">
      <h2 class="mk-h2">Stop duct-taping.<br>Start building.</h2>
      <a href="/contact/" class="mk-btn mk-btn--yellow mk-btn--lg">
        Start a Project Conversation <i data-lucide="arrow-right" style="width:18px;height:18px;"></i>
      </a>
    </div>
  </section>

</Base>
