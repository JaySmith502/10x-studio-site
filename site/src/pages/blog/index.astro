---
import Base from '../../layouts/Base.astro';
import WellTile from '../../components/WellTile.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const kindLabel: Record<string, string> = { essay: 'Essay', 'case-study': 'Case study', note: 'Note' };
---
<Base title="Journal — 10x Studio" description="Field notes on building software for businesses with real operational complexity. Engineering, AI, and the workflows underneath." active="blog">

  <section class="svc-hero">
    <div class="svc-hero-inner">
      <div class="mk-eyebrow" style="margin-bottom:18px;"><b>//</b> The 10x Journal</div>
      <h1 class="mk-h1">Field notes from the <span class="accent">build floor.</span></h1>
      <p>Essays and case studies on engineering software for businesses with real operational complexity. Slow cadence, long form, no listicles.</p>
    </div>
  </section>

  <section class="mk-section">
    <div class="mk-wrap">
      <div class="blog-list">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="blog-card">
            <div class="blog-card-art">
              <WellTile set={post.data.heroSet} size={96} />
            </div>
            <div class="blog-card-body">
              <div class="blog-card-meta">
                <span class="kind">{kindLabel[post.data.kind]}</span>
                <span class="dot-sep">·</span>
                <span>{fmt(post.data.pubDate)}</span>
              </div>
              <h2 class="mk-h3" style="font-size:28px; margin-top:10px;">{post.data.title}</h2>
              <p class="blog-card-desc">{post.data.description}</p>
              <div class="blog-card-tags">
                {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
              </div>
            </div>
            <span class="blog-card-arrow"><i data-lucide="arrow-up-right" style="width:22px;height:22px;"></i></span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Base>
