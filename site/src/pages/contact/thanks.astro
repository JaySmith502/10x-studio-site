---
import Base from '../../layouts/Base.astro';
---
<Base title="We're on it — 10x Studio" description="Brief received. We'll be in touch within one business day." active="contact">
  <section class="hero">
    <div class="hero-inner" style="grid-template-columns:1fr; max-width:720px;">
      <div>
        <div class="mk-eyebrow" style="margin-bottom:18px;">
          <span class="mk-badge mk-badge--blue">Received</span>
        </div>
        <h1 class="mk-h1">We're <span class="accent">on it.</span></h1>
        <p>Thanks for the brief. An engineer (the one who would actually build it) will reach out within one business day to set up a working session.</p>
        <div class="hero-ctas">
          <a href="/services/" class="mk-btn mk-btn--primary mk-btn--lg">See What We Build</a>
          <a href="/" class="mk-btn mk-btn--outline mk-btn--lg">Back home</a>
        </div>
      </div>
    </div>
  </section>
</Base>
