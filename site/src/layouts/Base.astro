---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/styles.css';
import '../styles/site.css';
import '../styles/case-studies.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'services' | 'about' | 'case-studies' | 'blog' | 'guides' | 'contact';
  /** Optional Open Graph type override; defaults to "website". Articles use "article". */
  ogType?: 'website' | 'article';
  /** Optional absolute or root-relative URL of a preview image (1200x630 ideal). */
  ogImage?: string;
  /** Optional JSON-LD structured data block(s). Rendered into <head> as application/ld+json.
      Pass one object or an array; arrays emit one script tag per object. Drives AEO / rich results. */
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** ISO date strings for article OG meta (only emitted when ogType="article"). */
  datePublished?: string;
  dateModified?: string;
}

const { title, description, active = 'home', ogType = 'website', ogImage, jsonLd, datePublished, dateModified } = Astro.props;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const defaultDesc = 'AI-native web platforms, ecommerce systems and custom software for businesses with real operational complexity.';
const desc = description ?? defaultDesc;

// Canonical URL: prefer Astro.site (configured to https://10xstudio.dev) + current pathname.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://10xstudio.dev').toString();
// Default share image: brand hero crop (1200x630) lives at /assets/og-image.png.
// Pass `ogImage` per page to override (e.g. case-study illustrations once they're sized correctly).
const ogImageAbs = new URL(ogImage ?? '/assets/og-image.png', Astro.site ?? 'https://10xstudio.dev').toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />

  <!-- Canonical -->
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:site_name" content="10x Studio" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="10x Studio — software that does the work your business needs." />
  {ogType === 'article' && datePublished && (
    <meta property="article:published_time" content={datePublished} />
  )}
  {ogType === 'article' && dateModified && (
    <meta property="article:modified_time" content={dateModified} />
  )}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImageAbs} />
  <meta name="twitter:image:alt" content="10x Studio — software that does the work your business needs." />

  <!-- Preconnects for Google Fonts (used by tokens/fonts.css) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  {/* Per-page structured data (Article, Service, FAQPage, BreadcrumbList, …) */}
  {jsonLdBlocks.map((block) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
  ))}
</head>
<body class="mk">
  <Nav active={active} />
  <main>
    <slot />
  </main>
  <Footer />
  <CookieConsent />
</body>
</html>
