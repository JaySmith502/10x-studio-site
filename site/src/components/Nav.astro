---
interface Props {
  active?: 'home' | 'services' | 'about' | 'case-studies' | 'blog' | 'contact';
}
const { active = 'home' } = Astro.props;
import Icon from './Icon.astro';
---
<header class="mk-nav">
  <div class="mk-wrap mk-nav-inner">
    <a href="/" class="mk-logo">
      <img src="/assets/logo-mark.svg" alt="10x Studio" width="36" height="36" />
      <span class="mk-logo-text">
        <span class="top">10x</span>
        <span class="bottom">Studio</span>
      </span>
    </a>
    <nav class="mk-nav-links">
      <a href="/" class={active === 'home' ? 'active' : ''}>Home</a>
      <a href="/services/" class={active === 'services' ? 'active' : ''}>Services</a>
      <a href="/case-studies/" class={active === 'case-studies' ? 'active' : ''}>Work</a>
      <a href="/about/" class={active === 'about' ? 'active' : ''}>About</a>
      <a href="/blog/" class={active === 'blog' ? 'active' : ''}>Journal</a>
      <a href="/contact/" class={active === 'contact' ? 'active' : ''}>Contact</a>
    </nav>
    <a href="/contact/" class="mk-btn mk-btn--solid mk-btn--sm">
      Start a project <Icon name="arrow-right" size={16} />
    </a>
  </div>
</header>
