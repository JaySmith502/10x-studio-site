---
interface Props {
  active?: 'home' | 'services' | 'pricing' | 'about' | 'case-studies' | 'blog' | 'guides' | 'contact';
}
const { active = 'home' } = Astro.props;
import Icon from './Icon.astro';
const links = [
  ['services', '/services/', 'Services'],
  ['pricing', '/pricing/', 'Pricing'],
  ['case-studies', '/case-studies/', 'Work'],
  ['guides', '/guides/', 'Guides'],
  ['blog', '/blog/', 'Journal'],
  ['about', '/about/', 'About'],
] as const;
---
<header class="mk-nav">
  <div class="mk-wrap mk-nav-inner">
    <a href="/" class="mk-logo" aria-label="10x Studio home">10x <span>Studio</span></a>
    <nav class="mk-nav-links" aria-label="Main">
      {links.map(([key, href, label]) => (
        <a href={href} class={active === key ? 'active' : ''} aria-current={active === key ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <a href="/contact/" class="mk-btn mk-btn--sm">Start a project <Icon name="arrow-right" size={16} /></a>
    <details class="mk-menu">
      <summary>Menu</summary>
      <nav aria-label="Main">
        {links.map(([key, href, label]) => (
          <a href={href} class={active === key ? 'active' : ''} aria-current={active === key ? 'page' : undefined}>{label}</a>
        ))}
        <a href="/contact/" class={active === 'contact' ? 'active' : ''}>Start a project</a>
      </nav>
    </details>
  </div>
</header>
