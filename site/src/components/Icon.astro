---
/**
 * Inline-SVG icon component — replaces the Lucide CDN runtime.
 *
 * Why: the runtime version shipped ~70KB of JS per page and walked the DOM
 * to replace <i data-lucide="…"> tags. Inlining at build time means zero JS,
 * zero DOM walk, and the icon is paintable on first frame.
 *
 * Add new icons by pasting their Lucide path data into ICONS below.
 * Source: https://lucide.dev/icons
 */
interface Props {
  name: 'arrow-right' | 'arrow-up-right' | 'clock' | 'mail' | 'map-pin' | 'shield-check';
  size?: number;
  stroke?: number;
  class?: string;
  style?: string;
}

const { name, size = 18, stroke = 2, class: cls, style } = Astro.props;

// Lucide v0.460.0 path data. Each entry is the innerHTML of a 24x24 viewBox SVG.
const ICONS: Record<string, string> = {
  'arrow-right':
    '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  'arrow-up-right':
    '<path d="M7 7h10v10"/><path d="M7 17 17 7"/>',
  'clock':
    '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  'mail':
    '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  'map-pin':
    '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
  'shield-check':
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
};

const inner = ICONS[name] ?? '';
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  style={style}
  aria-hidden="true"
  set:html={inner}
></svg>
