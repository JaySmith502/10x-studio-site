---
// Cookie consent (GDPR + US/CCPA). vanilla-cookieconsent v3, themed to the drawing-set identity (DESIGN.md).
// Currently the site ships zero non-essential cookies, so the `analytics` category
// gates nothing yet - it's here so analytics can be dropped in behind consent later:
// mark tags <script type="text/plain" data-category="analytics"> and CC will run them on accept.
import 'vanilla-cookieconsent/dist/cookieconsent.css';
---

<script>
  import * as CookieConsent from 'vanilla-cookieconsent';

  document.documentElement.classList.add('cc--drawing');

  CookieConsent.run({
    guiOptions: {
      consentModal: { layout: 'box', position: 'bottom left', equalWeightButtons: true },
      preferencesModal: { layout: 'box', equalWeightButtons: true },
    },

    categories: {
      necessary: { enabled: true, readOnly: true },
      analytics: {},
    },

    language: {
      default: 'en',
      translations: {
        en: {
          consentModal: {
            title: 'Cookies, only where they earn their keep',
            description:
              'We use strictly necessary cookies to run this site. Analytics cookies stay off until you turn them on. We never sell your data or run ad trackers.',
            acceptAllBtn: 'Accept all',
            acceptNecessaryBtn: 'Reject all',
            showPreferencesBtn: 'Manage preferences',
            footer:
              '<a href="/piii/privacy-policy/">Privacy Policy</a>',
          },
          preferencesModal: {
            title: 'Cookie preferences',
            acceptAllBtn: 'Accept all',
            acceptNecessaryBtn: 'Reject all',
            savePreferencesBtn: 'Save my choices',
            closeIconLabel: 'Close',
            sections: [
              {
                title: 'How we use cookies',
                description:
                  'You control everything that is not essential. Turn a category off and we never set it. You can change your mind any time via the "Cookie settings" link in the footer.',
              },
              {
                title: 'Strictly necessary',
                description:
                  'Required for the site to load and work: page delivery and the contact form. These cannot be switched off.',
                linkedCategory: 'necessary',
              },
              {
                title: 'Analytics',
                description:
                  'Anonymous usage measurement so we can see what is useful and what to fix. Off by default; nothing is set until you opt in.',
                linkedCategory: 'analytics',
              },
              {
                title: 'More information',
                description:
                  'Questions about how we handle your data? <a href="/contact/">Contact us</a>.',
              },
            ],
          },
        },
      },
    },
  });
</script>

<style is:global>
  /* Drawing-set theme: bone sheet, graphite lines, square corners, no shadows. */
  .cc--drawing {
    color-scheme: light;
    --cc-font-family: var(--font-body);
    --cc-bg: var(--bone);
    --cc-primary-color: var(--graphite);
    --cc-secondary-color: var(--graphite-soft);
    --cc-link-color: var(--graphite);

    --cc-btn-primary-bg: var(--graphite);
    --cc-btn-primary-color: var(--bone);
    --cc-btn-primary-border-color: var(--graphite);
    --cc-btn-primary-hover-bg: var(--highlighter);
    --cc-btn-primary-hover-color: var(--graphite);
    --cc-btn-primary-hover-border-color: var(--graphite);

    --cc-btn-secondary-bg: transparent;
    --cc-btn-secondary-color: var(--graphite);
    --cc-btn-secondary-border-color: var(--graphite);
    --cc-btn-secondary-hover-bg: var(--highlighter);
    --cc-btn-secondary-hover-color: var(--graphite);
    --cc-btn-secondary-hover-border-color: var(--graphite);

    --cc-separator-border-color: var(--rule);
    --cc-toggle-on-bg: var(--graphite);
    --cc-toggle-off-bg: var(--graphite-soft);
    --cc-toggle-on-knob-bg: var(--bone);
    --cc-toggle-off-knob-bg: var(--bone);
    --cc-toggle-readonly-bg: var(--bone-deep);
    --cc-toggle-readonly-knob-bg: var(--graphite-soft);
    --cc-toggle-readonly-knob-icon-color: var(--bone);

    --cc-cookie-category-block-bg: var(--bone-deep);
    --cc-cookie-category-block-border: var(--rule);
    --cc-cookie-category-block-hover-bg: var(--bone-deep);
    --cc-cookie-category-block-hover-border: var(--graphite);
    --cc-cookie-category-expanded-block-bg: var(--bone);
    --cc-cookie-category-expanded-block-hover-bg: var(--bone-deep);

    --cc-overlay-bg: oklch(23% 0.012 250 / 0.5);
    --cc-footer-bg: var(--bone-deep);
    --cc-footer-color: var(--graphite-soft);
    --cc-footer-border-color: var(--rule);

    --cc-btn-border-radius: 0;
    --cc-modal-border-radius: 0;
    --cc-pm-toggle-border-radius: 0;
  }
  .cc--drawing #cc-main .cm,
  .cc--drawing #cc-main .pm { border: 1px solid var(--graphite); box-shadow: none; }
  .cc--drawing #cc-main .cm__title,
  .cc--drawing #cc-main .pm__title { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; }
  .cc--drawing #cc-main .cm__btn,
  .cc--drawing #cc-main .pm__btn { font-weight: 600; border-width: 1px; }
</style>
